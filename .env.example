# KEYCARD servicer configuration. Copy to .env.testnet / .env.mainnet (gitignored) or set as host env vars.
TEMPO_NETWORK=testnet                 # testnet | mainnet

# Operator keys (generate with: pnpm --filter @keycard/sdk exec tsx scripts/keygen.ts testnet)
TREASURY_PK=                          # owns contracts, funds lines, receives repayments, sponsors all fees
ATTESTER_PK=                          # writes Self attestations to KeycardRegistry
SERVICER_PK=                          # writes the public credit file (LineBook)
SETTLEMENT_PK=                        # KEYCARD network settlement address (card payments land here, then merchants are paid)
KEY_ENC_SECRET=                       # 32+ random bytes, base64; encrypts server-held keys at rest

DATABASE_URL=postgres://keycard:keycard@127.0.0.1:5544/keycard
PORT=8787
WEB_ORIGINS=http://localhost:3000     # comma-separated origins the app is served from (passkey origin/rpId checks + CORS)
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Line economics (token base units, 6 decimals)
PERIOD_SECONDS=2592000                # 30 days (use 90 on testnet demos)
GRACE_SECONDS=432000                  # 5 days  (use 60 on testnet demos)
TERM_DAYS=180
TIERS=20000000,50000000,100000000     # $20 -> $50 -> $100
CARD_LIMIT=10000000                   # physical NFC card tap limit per period ($10)
EXCLUDED_COUNTRIES=                   # e.g. IND. Empty during the hackathon pilot; see docs

# Self Protocol (dashboard.self.xyz)
SELF_API_KEY=
SELF_FLOW_ID_BORROWER=
SELF_FLOW_ID_GUARANTOR=
SELF_WEBHOOK_SECRET=

ADMIN_TOKEN=                          # 24+ chars, protects /api/admin/*
ALLOW_DEV_VERIFY=0                    # 1 = testnet-only "skip verification" button
ALLOW_UNVERIFIED_REGISTRATION=0       # 1 = testnet-only raw-key registration used by API e2e tests
