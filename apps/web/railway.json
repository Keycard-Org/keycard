{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @keycard/web build"
  },
  "deploy": {
    "startCommand": "cd apps/web && ./node_modules/.bin/next start -p $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
